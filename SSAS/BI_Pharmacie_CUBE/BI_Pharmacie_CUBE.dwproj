  <Configurations>
    <Configuration>
      <Name>Development</Name>
      <Options>
        <ConnectionMappings>
          <ConfigurationSetting>
            <Id>Bi Db Datamarts</Id>
            <Name>Bi Db Datamarts</Name>
            <Value xsi:type="xsd:string">Data Source=YOUR_SQL_SERVER_INSTANCE;Initial Catalog=bi_db_datamarts;Integrated Security=True</Value>
          </ConfigurationSetting>
        </ConnectionMappings>
        <ConnectionProviderMappings>
          <ConfigurationSetting>
            <Id>Bi Db Datamarts</Id>
            <Name>Bi Db Datamarts</Name>
            <Value xsi:type="xsd:string">System.Data.SqlClient</Value>
          </ConfigurationSetting>
        </ConnectionProviderMappings>
        <ConnectionSecurityMappings>
          <ConfigurationSetting>
            <Id>Bi Db Datamarts</Id>
            <Name>Bi Db Datamarts</Name>
            <Value xsi:type="xsd:int">0</Value>
          </ConfigurationSetting>
        </ConnectionSecurityMappings>
      </Options>
